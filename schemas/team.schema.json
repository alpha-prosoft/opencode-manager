{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamConfig",
  "description": "A team's own configuration: .platform/team.json in the team repository. Leaving out llm_connections or mcp_servers means every one the tenant grants the team.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "TeamBudget": {
      "additionalProperties": false,
      "properties": {
        "daily_tokens": {
          "anyOf": [
            {
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prompt + completion tokens per UTC day",
          "title": "Daily Tokens"
        },
        "max_running_sessions": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concurrent running sessions",
          "title": "Max Running Sessions"
        },
        "idle_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stop the team's sessions after this many idle minutes (caps each harness's idle_minutes)",
          "title": "Idle Minutes"
        }
      },
      "title": "TeamBudget",
      "type": "object"
    },
    "TeamLlmConnection": {
      "title": "TeamLlmConnection",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string",
          "title": "Id",
          "description": "An LLM connection of the tenant"
        },
        "models": {
          "title": "Models",
          "description": "Models the team may use; default all the connection offers",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "ScmProject": {
      "title": "ScmProject",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "bitbucket",
            "github",
            "gerrit"
          ],
          "type": "string",
          "title": "Provider"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
          "type": "string",
          "title": "Repository",
          "description": "workspace/repository (Bitbucket, GitHub) or the project name (Gerrit)"
        },
        "url": {
          "pattern": "^https?://",
          "type": "string",
          "title": "Url",
          "description": "Base URL of a self-hosted provider (Gerrit), e.g. http://gerrit:8080"
        },
        "web_url": {
          "pattern": "^https?://",
          "type": "string",
          "title": "Web Url",
          "description": "Where browsers reach the provider, for links to changes (default: url)"
        },
        "credentials": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "type": "string",
          "title": "Credentials",
          "description": "A credential granted to the team"
        }
      },
      "required": [
        "provider",
        "repository"
      ]
    },
    "CiProject": {
      "title": "CiProject",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp_server": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string",
          "title": "Mcp Server",
          "description": "The tenant's MCP server of the CI system"
        },
        "jobs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "title": "Jobs"
        },
        "job": {
          "type": "string",
          "minLength": 1,
          "title": "Job",
          "description": "The job that builds the project's changes (see options.ci.job of the implement activity); workflows of the project follow it"
        }
      },
      "required": [
        "mcp_server"
      ]
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string",
          "title": "Id"
        },
        "name": {
          "type": "string",
          "title": "Name"
        },
        "branch": {
          "pattern": "^[A-Za-z0-9._/-]{1,200}$",
          "type": "string",
          "title": "Branch",
          "description": "The main branch (default main)"
        },
        "scm": {
          "$ref": "#/$defs/ScmProject"
        },
        "ci": {
          "$ref": "#/$defs/CiProject"
        }
      },
      "required": [
        "id",
        "scm"
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version"
    },
    "budget": {
      "$ref": "#/$defs/TeamBudget",
      "default": {}
    },
    "llm_connections": {
      "title": "Llm Connections",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TeamLlmConnection"
      },
      "description": "The tenant's LLM connections (and models) the team uses"
    },
    "mcp_servers": {
      "title": "Mcp Servers",
      "type": "array",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "description": "The tenant's MCP servers the team uses"
    },
    "projects": {
      "title": "Projects",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Project"
      },
      "description": "Source repositories and CI jobs the team works on"
    },
    "required_credentials": {
      "title": "Required Credentials",
      "default": [],
      "type": "array",
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Credentials each member must add their own value of (declared in tenant.json with \"user\" in provided_by); team and tenant values don't satisfy them"
    }
  }
}
