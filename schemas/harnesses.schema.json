{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "HarnessLlm": {
      "additionalProperties": false,
      "properties": {
        "connection": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Connection",
          "type": "string"
        },
        "models": {
          "description": "Tried in order",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "connection",
        "models"
      ],
      "title": "HarnessLlm",
      "type": "object"
    },
    "HarnessResources": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 8,
          "title": "Cpus",
          "type": "number"
        },
        "memory_mb": {
          "default": 2048,
          "maximum": 32768,
          "minimum": 256,
          "title": "Memory Mb",
          "type": "integer"
        },
        "pids": {
          "default": 512,
          "maximum": 4096,
          "minimum": 64,
          "title": "Pids",
          "type": "integer"
        }
      },
      "title": "HarnessResources",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": ".platform/harnesses/<id>.json \u2014 the sandbox an agent runs in.",
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Must be in the platform's allowed_images",
      "title": "Image"
    },
    "llm": {
      "$ref": "#/$defs/HarnessLlm"
    },
    "network": {
      "default": "none",
      "description": "none: only the platform LLM gateway is reachable",
      "enum": [
        "none",
        "internet"
      ],
      "title": "Network",
      "type": "string"
    },
    "permissions": {
      "additionalProperties": {
        "enum": [
          "allow",
          "ask",
          "deny"
        ],
        "type": "string"
      },
      "default": {},
      "description": "OpenCode tool permissions, e.g. {\"bash\": \"allow\", \"webfetch\": \"deny\"}",
      "title": "Permissions",
      "type": "object"
    },
    "resources": {
      "$ref": "#/$defs/HarnessResources",
      "default": {
        "cpus": 1.0,
        "memory_mb": 2048,
        "pids": 512
      }
    },
    "idle_minutes": {
      "default": 15,
      "maximum": 1440,
      "minimum": 1,
      "title": "Idle Minutes",
      "type": "integer"
    }
  },
  "required": [
    "llm"
  ],
  "title": "HarnessSpec",
  "type": "object"
}
