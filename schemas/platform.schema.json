{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArchiveSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "url",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "description": "https:// URL of a .tar.gz or .zip archive",
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        },
        "credentials": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platform secret sent as a Bearer token",
          "title": "Credentials"
        },
        "path": {
          "default": ".platform",
          "description": "Directory inside the archive with the definitions",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "ArchiveSource",
      "type": "object"
    },
    "CredentialSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Referenced by MCP servers, repositories and triggers",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "default": "token",
          "description": "token: one secret; basic: username and password; ssh_key: a private key",
          "enum": [
            "token",
            "basic",
            "ssh_key"
          ],
          "title": "Kind",
          "type": "string"
        },
        "hosts": {
          "default": [],
          "description": "The only hosts this credential may be sent to",
          "items": {
            "type": "string"
          },
          "title": "Hosts",
          "type": "array"
        },
        "provided_by": {
          "default": "platform",
          "description": "platform: admins set one value; platform_or_user: users may use their own instead; user: every user sets their own",
          "enum": [
            "platform",
            "platform_or_user",
            "user"
          ],
          "title": "Provided By",
          "type": "string"
        },
        "teams": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "*",
              "type": "string"
            }
          ],
          "default": "*",
          "title": "Teams"
        },
        "help": {
          "default": "",
          "description": "Shown to people when they enter the value, e.g. where to create a token",
          "title": "Help",
          "type": "string"
        },
        "test": {
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialTest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "CredentialSpec",
      "type": "object"
    },
    "CredentialTest": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "Endpoint called with the credential; a 2xx answer means it works",
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "CredentialTest",
      "type": "object"
    },
    "GitSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "git",
          "default": "git",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "description": "https://, ssh (git@host:org/repo.git) or file:// URL of the repository",
          "title": "Url",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "title": "Branch",
          "type": "string"
        },
        "credentials": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platform secret: a token for https URLs, a private key for ssh URLs",
          "title": "Credentials"
        },
        "username": {
          "default": "x-token-auth",
          "description": "Username sent with the token (Basic auth)",
          "title": "Username",
          "type": "string"
        },
        "path": {
          "default": ".platform",
          "description": "Directory inside the repository with the definitions",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "GitSource",
      "type": "object"
    },
    "LlmConnection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "default": "openai-compatible",
          "enum": [
            "openai-compatible",
            "github-copilot"
          ],
          "title": "Type",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream base URL (defaults per type)",
          "title": "Base Url"
        },
        "secret": {
          "description": "Platform secret with the API key or OAuth token",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Secret",
          "type": "string"
        },
        "models": {
          "description": "Models teams may use through this connection",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Models",
          "type": "array"
        },
        "teams": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "*",
              "type": "string"
            }
          ],
          "default": "*",
          "title": "Teams"
        },
        "pricing": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelPrice"
          },
          "default": {},
          "description": "Optional prices per model, for cost estimates",
          "title": "Pricing",
          "type": "object"
        }
      },
      "required": [
        "id",
        "secret",
        "models"
      ],
      "title": "LlmConnection",
      "type": "object"
    },
    "McpAuth": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "default": "Authorization",
          "pattern": "^[A-Za-z0-9-]{1,64}$",
          "title": "Header",
          "type": "string"
        },
        "scheme": {
          "default": "bearer",
          "enum": [
            "bearer",
            "basic",
            "raw"
          ],
          "title": "Scheme",
          "type": "string"
        }
      },
      "title": "McpAuth",
      "type": "object"
    },
    "McpServerSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "url": {
          "description": "Streamable HTTP endpoint of the MCP server, reached from the platform only",
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "credential": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Credential the platform adds to every request",
          "title": "Credential"
        },
        "auth": {
          "$ref": "#/$defs/McpAuth",
          "default": {
            "header": "Authorization",
            "scheme": "bearer"
          }
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allow-list of tool names; all tools when omitted",
          "title": "Tools"
        },
        "teams": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "*",
              "type": "string"
            }
          ],
          "default": "*",
          "title": "Teams"
        }
      },
      "required": [
        "id",
        "name",
        "url"
      ],
      "title": "McpServerSpec",
      "type": "object"
    },
    "ModelPrice": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "description": "Price per million prompt tokens",
          "minimum": 0,
          "title": "Input",
          "type": "number"
        },
        "output": {
          "description": "Price per million completion tokens",
          "minimum": 0,
          "title": "Output",
          "type": "number"
        },
        "cached_input": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Price per million cached prompt tokens",
          "title": "Cached Input"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "ModelPrice",
      "type": "object"
    },
    "PathSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "path",
          "title": "Type",
          "type": "string"
        },
        "location": {
          "description": "Absolute directory on the platform host (must be under an allowed root)",
          "title": "Location",
          "type": "string"
        },
        "path": {
          "default": ".platform",
          "description": "Directory inside location with the definitions",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "type",
        "location"
      ],
      "title": "PathSource",
      "type": "object"
    },
    "TeamBudget": {
      "additionalProperties": false,
      "properties": {
        "daily_tokens": {
          "anyOf": [
            {
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prompt + completion tokens per UTC day",
          "title": "Daily Tokens"
        },
        "max_running_sessions": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concurrent running sessions",
          "title": "Max Running Sessions"
        }
      },
      "title": "TeamBudget",
      "type": "object"
    },
    "TeamEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "repository": {
          "discriminator": {
            "mapping": {
              "git": "#/$defs/GitSource",
              "path": "#/$defs/PathSource",
              "url": "#/$defs/ArchiveSource"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "$ref": "#/$defs/ArchiveSource"
            },
            {
              "$ref": "#/$defs/PathSource"
            }
          ],
          "title": "Repository"
        },
        "members": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "admins": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          },
          "title": "Admins",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "description": "Platform secrets this team's workflows may use",
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/TeamBudget",
          "default": {
            "daily_tokens": null,
            "max_running_sessions": null
          }
        },
        "notifications": {
          "$ref": "#/$defs/TeamNotifications",
          "default": {
            "webhook": null,
            "on": [
              "completed",
              "failed"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "repository"
      ],
      "title": "TeamEntry",
      "type": "object"
    },
    "TeamNotifications": {
      "additionalProperties": false,
      "properties": {
        "webhook": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platform secret holding a webhook URL (e.g. Slack) called when runs finish",
          "title": "Webhook"
        },
        "on": {
          "default": [
            "completed",
            "failed"
          ],
          "items": {
            "enum": [
              "completed",
              "failed"
            ],
            "type": "string"
          },
          "title": "On",
          "type": "array"
        }
      },
      "title": "TeamNotifications",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "platform.json in the onboarding repository.",
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "admins": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "type": "string"
      },
      "title": "Admins",
      "type": "array"
    },
    "allowed_images": {
      "default": [
        "ghcr.io/anomalyco/opencode:1.19.5"
      ],
      "items": {
        "type": "string"
      },
      "title": "Allowed Images",
      "type": "array"
    },
    "llm_connections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LlmConnection"
      },
      "title": "Llm Connections",
      "type": "array"
    },
    "secret_hosts": {
      "default": {},
      "description": "Hosts each secret may be sent to when used for Git checkouts",
      "patternProperties": {
        "^[A-Z][A-Z0-9_]{0,63}$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Secret Hosts",
      "type": "object"
    },
    "credentials": {
      "default": [],
      "description": "Credentials people and admins fill in",
      "items": {
        "$ref": "#/$defs/CredentialSpec"
      },
      "title": "Credentials",
      "type": "array"
    },
    "mcp_servers": {
      "default": [],
      "description": "MCP servers run behind the platform gateway",
      "items": {
        "$ref": "#/$defs/McpServerSpec"
      },
      "title": "Mcp Servers",
      "type": "array"
    },
    "teams": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TeamEntry"
      },
      "title": "Teams",
      "type": "array"
    }
  },
  "title": "PlatformSpec",
  "type": "object"
}
