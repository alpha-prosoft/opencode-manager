[
  {
    "id": "session",
    "name": "Workspace",
    "category": "Workspace",
    "description": "An OpenCode workspace in the browser, for one person or shared by a team, optionally with a repository checked out.",
    "icon": "terminal",
    "interactive": true,
    "result_tool": null,
    "options_schema": {
      "$defs": {
        "GitSource": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "git",
              "default": "git",
              "title": "Type",
              "type": "string"
            },
            "url": {
              "description": "https://, ssh (git@host:org/repo.git) or file:// URL of the repository",
              "title": "Url",
              "type": "string"
            },
            "branch": {
              "default": "main",
              "title": "Branch",
              "type": "string"
            },
            "credentials": {
              "anyOf": [
                {
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Platform secret: a token for https URLs, a private key for ssh URLs",
              "title": "Credentials"
            },
            "username": {
              "default": "x-token-auth",
              "description": "Username sent with the token (Basic auth)",
              "title": "Username",
              "type": "string"
            },
            "path": {
              "default": ".platform",
              "description": "Directory inside the repository with the definitions",
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "GitSource",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repository checked out into the workspace"
        },
        "instructions_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Team repo file appended to the agent prompt",
          "title": "Instructions File"
        }
      },
      "title": "SessionOptions",
      "type": "object"
    },
    "inputs_schema": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "",
          "description": "Name shown in the session list",
          "maxLength": 100,
          "title": "Title",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First message sent to the agent",
          "title": "Prompt"
        },
        "branch": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._/-]{1,200}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Check out this branch instead of the default one",
          "title": "Branch"
        }
      },
      "title": "SessionInputs",
      "type": "object"
    }
  },
  {
    "id": "review",
    "name": "Code review",
    "category": "Quality",
    "description": "Reviews a pull request, or a branch of a repository, against the team's baseline. The agent submits a structured review; the platform plans and (for pull requests, optionally) posts comments with a hard limit.",
    "icon": "rate_review",
    "interactive": false,
    "result_tool": "submit_review",
    "options_schema": {
      "$defs": {
        "ScmSource": {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "bitbucket",
                "github",
                "gerrit"
              ],
              "title": "Provider",
              "type": "string"
            },
            "repository": {
              "description": "workspace/repository (Bitbucket, GitHub) or the project name (Gerrit)",
              "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
              "title": "Repository",
              "type": "string"
            },
            "url": {
              "description": "Base URL of a self-hosted provider (Gerrit), e.g. http://gerrit:8080",
              "pattern": "^https?://",
              "title": "Url",
              "type": "string"
            },
            "web_url": {
              "description": "Where browsers reach the provider, for links to changes (default: url)",
              "pattern": "^https?://",
              "title": "Web Url",
              "type": "string"
            },
            "credentials": {
              "title": "Credentials",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "repository",
            "credentials"
          ],
          "title": "ScmSource",
          "type": "object"
        },
        "GitSource": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "git",
              "default": "git",
              "title": "Type",
              "type": "string"
            },
            "url": {
              "description": "https://, ssh (git@host:org/repo.git) or file:// URL of the repository",
              "title": "Url",
              "type": "string"
            },
            "branch": {
              "default": "main",
              "title": "Branch",
              "type": "string"
            },
            "credentials": {
              "anyOf": [
                {
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Platform secret: a token for https URLs, a private key for ssh URLs",
              "title": "Credentials"
            },
            "username": {
              "default": "x-token-auth",
              "description": "Username sent with the token (Basic auth)",
              "title": "Username",
              "type": "string"
            },
            "path": {
              "default": ".platform",
              "description": "Directory inside the repository with the definitions",
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "GitSource",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "scm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScmSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where pull requests live (set by pull_request triggers). Set either scm or repository."
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Review a branch of this repository instead of a pull request; nothing is posted"
        },
        "guidelines_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Team repo file with the review baseline",
          "title": "Guidelines File"
        },
        "post_mode": {
          "default": "dry-run",
          "description": "What to do with the review",
          "enum": [
            "off",
            "dry-run",
            "auto"
          ],
          "title": "Post Mode",
          "type": "string"
        },
        "max_comments": {
          "default": 30,
          "description": "Upper bound on comments posted per PR",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Comments",
          "type": "integer"
        }
      },
      "title": "ReviewOptions",
      "type": "object"
    },
    "inputs_schema": {
      "additionalProperties": false,
      "properties": {
        "pull_request": {
          "description": "Pull request number",
          "minimum": 1,
          "title": "Pull Request",
          "type": "integer"
        }
      },
      "required": [
        "pull_request"
      ],
      "title": "ReviewInputs",
      "type": "object"
    },
    "branch_inputs_schema": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "description": "Branch to review",
          "pattern": "^[A-Za-z0-9._/-]{1,200}$",
          "title": "Branch",
          "type": "string"
        },
        "base": {
          "default": "main",
          "description": "Branch the change is compared against",
          "pattern": "^[A-Za-z0-9._/-]{1,200}$",
          "title": "Base",
          "type": "string"
        }
      },
      "required": [
        "branch"
      ],
      "title": "BranchReviewInputs",
      "type": "object"
    }
  },
  {
    "id": "implement",
    "name": "Implementation",
    "category": "Engineering",
    "description": "Implements a task in a repository and returns a reviewed patch. Optionally the platform opens or updates a pull request (never merged) and follows its build.",
    "icon": "build",
    "interactive": false,
    "result_tool": "submit_implementation",
    "options_schema": {
      "$defs": {
        "CiFollow": {
          "additionalProperties": false,
          "properties": {
            "mcp_server": {
              "description": "MCP server whose get_build tool reads the CI system (e.g. jenkins)",
              "title": "Mcp Server",
              "type": "string"
            },
            "job": {
              "description": "Job that builds the change. With {pr} (replaced by the pull request number, e.g. folder/repo/PR-{pr}) its last build is followed; without, the job is shared (a Gerrit verify job) and the build whose description names the pushed commit is followed",
              "title": "Job",
              "type": "string"
            },
            "timeout_minutes": {
              "default": 120,
              "description": "Give up waiting for the build after this long",
              "maximum": 720,
              "minimum": 5,
              "title": "Timeout Minutes",
              "type": "integer"
            },
            "on_failure": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Workflow (analysis or session) started with the failure details when the build fails",
              "title": "On Failure"
            }
          },
          "required": [
            "mcp_server",
            "job"
          ],
          "title": "CiFollow",
          "type": "object"
        },
        "GitSource": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "git",
              "default": "git",
              "title": "Type",
              "type": "string"
            },
            "url": {
              "description": "https://, ssh (git@host:org/repo.git) or file:// URL of the repository",
              "title": "Url",
              "type": "string"
            },
            "branch": {
              "default": "main",
              "title": "Branch",
              "type": "string"
            },
            "credentials": {
              "anyOf": [
                {
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Platform secret: a token for https URLs, a private key for ssh URLs",
              "title": "Credentials"
            },
            "username": {
              "default": "x-token-auth",
              "description": "Username sent with the token (Basic auth)",
              "title": "Username",
              "type": "string"
            },
            "path": {
              "default": ".platform",
              "description": "Directory inside the repository with the definitions",
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "GitSource",
          "type": "object"
        },
        "PullRequestDelivery": {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "bitbucket",
                "github",
                "gerrit"
              ],
              "title": "Provider",
              "type": "string"
            },
            "repository": {
              "description": "workspace/repository (Bitbucket, GitHub) or the project name (Gerrit)",
              "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
              "title": "Repository",
              "type": "string"
            },
            "url": {
              "description": "Base URL of a self-hosted provider (Gerrit), e.g. http://gerrit:8080",
              "pattern": "^https?://",
              "title": "Url",
              "type": "string"
            },
            "web_url": {
              "description": "Where browsers reach the provider, for links to changes (default: url)",
              "pattern": "^https?://",
              "title": "Web Url",
              "type": "string"
            },
            "target_branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Branch the pull request targets (default: the branch worked on)",
              "title": "Target Branch"
            }
          },
          "required": [
            "provider",
            "repository"
          ],
          "title": "PullRequestDelivery",
          "type": "object",
          "description": "Push the change for review: a new branch and pull request (Bitbucket, GitHub) or a change pushed to refs/for/<branch> (Gerrit)"
        }
      },
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/GitSource",
          "description": "Repository the change is made in"
        },
        "pull_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/PullRequestDelivery"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Push the change to a new branch and open a pull request (never merged), using the repository credential"
        },
        "guidelines_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Team repo file with coding guidelines",
          "title": "Guidelines File"
        },
        "ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/CiFollow"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Follow the pull request's build after it is pushed"
        }
      },
      "required": [
        "repository"
      ],
      "title": "ImplementOptions",
      "type": "object"
    },
    "inputs_schema": {
      "additionalProperties": false,
      "properties": {
        "task": {
          "description": "What to implement",
          "maxLength": 20000,
          "minLength": 10,
          "title": "Task",
          "type": "string"
        },
        "pull_request": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Continue on this open pull request: its branch is checked out and the change is pushed to it",
          "title": "Pull Request"
        },
        "branch": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._/-]{1,200}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Base branch (defaults to the repository branch)",
          "title": "Branch"
        }
      },
      "required": [
        "task"
      ],
      "title": "ImplementInputs",
      "type": "object"
    }
  },
  {
    "id": "analysis",
    "name": "Analysis",
    "category": "Discovery",
    "description": "Turns a brief into a structured analysis document (requirements, risks, open questions).",
    "icon": "description",
    "interactive": false,
    "result_tool": "submit_document",
    "options_schema": {
      "$defs": {
        "GitSource": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "git",
              "default": "git",
              "title": "Type",
              "type": "string"
            },
            "url": {
              "description": "https://, ssh (git@host:org/repo.git) or file:// URL of the repository",
              "title": "Url",
              "type": "string"
            },
            "branch": {
              "default": "main",
              "title": "Branch",
              "type": "string"
            },
            "credentials": {
              "anyOf": [
                {
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Platform secret: a token for https URLs, a private key for ssh URLs",
              "title": "Credentials"
            },
            "username": {
              "default": "x-token-auth",
              "description": "Username sent with the token (Basic auth)",
              "title": "Username",
              "type": "string"
            },
            "path": {
              "default": ".platform",
              "description": "Directory inside the repository with the definitions",
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "GitSource",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional repository for context"
        },
        "template_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Team repo file with the document template",
          "title": "Template File"
        }
      },
      "title": "AnalysisOptions",
      "type": "object"
    },
    "inputs_schema": {
      "additionalProperties": false,
      "properties": {
        "brief": {
          "description": "What to analyse",
          "maxLength": 20000,
          "minLength": 10,
          "title": "Brief",
          "type": "string"
        }
      },
      "required": [
        "brief"
      ],
      "title": "AnalysisInputs",
      "type": "object"
    }
  }
]
