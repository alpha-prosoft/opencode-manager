{
  "realm": "agent-platform",
  "displayName": "Agent Platform (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 43200,
  "roles": {
    "realm": [
      {
        "name": "tenant-admin",
        "description": "Administers the person's tenant"
      },
      {
        "name": "platform-operator",
        "description": "Operates the platform: registers tenants, sees every tenant's sync state"
      }
    ]
  },
  "groups": [
    {
      "name": "acme",
      "subGroups": [
        {
          "name": "demo",
          "subGroups": [
            {
              "name": "admin",
              "subGroups": []
            }
          ]
        },
        {
          "name": "payments",
          "subGroups": [
            {
              "name": "admin",
              "subGroups": []
            }
          ]
        },
        {
          "name": "ops",
          "subGroups": [
            {
              "name": "admin",
              "subGroups": []
            }
          ]
        }
      ]
    },
    {
      "name": "globex",
      "subGroups": [
        {
          "name": "research",
          "subGroups": [
            {
              "name": "admin",
              "subGroups": []
            }
          ]
        },
        {
          "name": "lab",
          "subGroups": [
            {
              "name": "admin",
              "subGroups": []
            }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agent-platform",
      "name": "Agent Platform",
      "description": "The manager (MANAGER_AUTH_MODE=oidc). Local only: the secret is public.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-platform-local-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/api/auth/oidc/callback",
        "http://localhost:18000/api/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/login##http://localhost:18000/login"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "multivalued": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "groups",
            "full.path": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
